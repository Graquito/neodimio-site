---
interface Props {
  active?: "gobierno" | "noticias";
}
const { active } = Astro.props;
const cls = (key: string) => (active === key ? "is-active" : undefined);
---

<header class="nav">
  <a href="/" class="brand" aria-label="Neodimio">
    <img src="/neodimio-green-transparent.png" alt="" class="brand__mark" width="827" height="140" />
  </a>

  <nav class="links">
    <a href="/gobierno" class={cls("gobierno")}>Gobierno</a>
    <a href="/newsroom" class={cls("noticias")}>Noticias</a>
  </nav>

  <div class="nav__right">
    <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" type="button">
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
    </button>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <a href="/gobierno" class="mobile-link">Gobierno</a>
  <a href="/newsroom" class="mobile-link">Noticias</a>
</div>

<script is:inline>
  // Event delegation: sobrevive a ViewTransitions sin re-bindear.
  (function () {
    if (window.__neodimioMenuBound) return;
    window.__neodimioMenuBound = true;

    function setOpen(open) {
      const toggle = document.querySelector(".menu-toggle");
      const menu = document.getElementById("mobile-menu");
      if (!toggle || !menu) return;
      menu.classList.toggle("is-open", open);
      toggle.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      menu.setAttribute("aria-hidden", String(!open));
      document.body.style.overflow = open ? "hidden" : "";
    }

    document.addEventListener("click", (e) => {
      const toggle = e.target.closest(".menu-toggle");
      if (!toggle) return;
      const menu = document.getElementById("mobile-menu");
      if (!menu) return;
      setOpen(!menu.classList.contains("is-open"));
    });

    document.addEventListener("keydown", (e) => {
      const menu = document.getElementById("mobile-menu");
      if (e.key === "Escape" && menu && menu.classList.contains("is-open")) {
        setOpen(false);
      }
    });

    document.addEventListener("astro:before-preparation", () => setOpen(false));
    document.addEventListener("astro:page-load", () => setOpen(false));
  })();
</script>
